# Go build/test artifacts
/bin/
/dist/
*.test
*.out
coverage.out
*.coverprofile
go.work
go.work.sum

# Spike benchmark output (regenerated by the benchmark harness; not committed per-run)
bench/results/*.jsonl
!bench/results/.gitkeep

# protoc-gen-go-styx's compile-and-round-trip test fixtures: regenerated by
# generate_roundtrip_integration_test.go / generate_streaming_test.go on every
# run, not committed.
cmd/protoc-gen-go-styx/testdata/echoroundtrip/echopb/
cmd/protoc-gen-go-styx/testdata/streamcompile/

# Logs
*.log
logs/

# Temp/scratch
tmp/
*.tmp
*.swp
*~

# Claude/agent local settings (keep .claude/ shared config trackable)
.claude/settings.local.json
.superpowers/

# Worktrees
.worktree/
.worktrees/

# Editor/IDE
.idea/
.vscode/
*.iml

# OS cruft
.DS_Store
Thumbs.db

# Env/secrets
.env
.env.*
